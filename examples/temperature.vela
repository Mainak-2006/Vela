// temperature.vela — functions returning values, and unit conversion.
//
// A small worked example of the shape most Vela programs take: pure functions
// over `number`, with a little string formatting for display.

fn celsiusToFahrenheit(c: number): number {
    return c * 9 / 5 + 32;
}

fn fahrenheitToCelsius(f: number): number {
    return (f - 32) * 5 / 9;
}

fn kelvinToCelsius(k: number): number {
    return k - 273.15;
}

fn celsiusToKelvin(c: number): number {
    return c + 273.15;
}

// `trunc`, `round`, and `idiv` are built-ins now, so they are not defined here.
// This file used to carry hand-written copies of all three as a recipe for
// working without them.

// One decimal place. Multiply by ten to move the digit we want, round to an
// integer, then split the whole part from the tenths digit.
fn oneDecimal(value: number): string {
    let tenths: number = round(value * 10);
    let whole: number = idiv(tenths, 10);
    let fraction: number = tenths % 10;
    if (fraction < 0) { fraction = 0 - fraction; }
    return tostring(whole) + "." + tostring(fraction);
}

fn isFreezing(c: number): bool {
    return c <= 0;
}

print("Celsius to Fahrenheit:");
for (let c: number = -10; c <= 40; c = c + 10) {
    print("  " + oneDecimal(c) + "C = " + oneDecimal(celsiusToFahrenheit(c)) + "F");
}

print("");
print("Fahrenheit to Celsius:");
for (let f: number = 32; f <= 212; f = f + 36) {
    print("  " + oneDecimal(f) + "F = " + oneDecimal(fahrenheitToCelsius(f)) + "C");
}

print("");
print("Kelvin:");
print("  273.15K = " + oneDecimal(kelvinToCelsius(273.15)) + "C");
print("  0C      = " + oneDecimal(celsiusToKelvin(0)) + "K");

print("");
print("Below freezing: " + tostring(isFreezing(-5)) + " " + tostring(isFreezing(20)));
