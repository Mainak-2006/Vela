// strings.vela — concatenation, comparison, indexing, escapes, and the built-ins.
//
// Indexing is the main thing to look at here. `s[i]` returns one UTF-16 code unit
// as a string, and `len` counts code units, so the two agree: index 0 through
// len(s) - 1 is the whole string. That is what makes a loop over a string work.
//
// The case, search, and slicing work below is all built in. `repeat`,
// `startsWith`, `indexOf`, and `substr` used to be recipes written out by hand;
// they are language built-ins now, so this file no longer defines them. Note the
// argument order: the subject comes first, the pattern second. That reads like
// the method calls these replace, where `s.startsWith(pre)` would put the subject
// first too.

fn pad(s: string, width: number): string {
    let out: string = s;
    while (len(out) < width) {
        out = out + ".";
    }
    return out;
}

// A positional comparison: equal length, then the same character at every index.
// This is `==` for the common case, written out so the indexing is visible.
fn sameCharacters(a: string, b: string): bool {
    if (len(a) != len(b)) { return false; }
    for (let i: number = 0; i < len(a); i = i + 1) {
        if (a[i] != b[i]) { return false; }
    }
    return true;
}

// A real anagram test needs order-independence, which means counting: for each
// character of `a`, confirm `b` contains exactly as many. The inner loop skips
// the character it is counting, so "ab" is not counted as two of "a".
fn countIn(s: string, c: string): number {
    let n: number = 0;
    for (let i: number = 0; i < len(s); i = i + 1) {
        if (s[i] == c) { n = n + 1; }
    }
    return n;
}

fn areAnagrams(a: string, b: string): bool {
    if (len(a) != len(b)) { return false; }
    for (let i: number = 0; i < len(a); i = i + 1) {
        if (countIn(b, a[i]) != countIn(a, a[i])) { return false; }
    }
    return true;
}

fn countOf(needle: string, hay: string): number {
    let n: number = len(needle);
    if (n == 0) { return 0; }
    let found: number = 0;
    // i + n <= len(hay) rather than i < len(hay), so a match cannot run off the end.
    for (let i: number = 0; i + n <= len(hay); i = i + 1) {
        let hit: bool = true;
        for (let j: number = 0; j < n; j = j + 1) {
            if (hay[i + j] != needle[j]) { hit = false; }
        }
        if (hit) { found = found + 1; }
    }
    return found;
}

let greeting: string = "hello";
let name: string = "world";

print(greeting + ", " + name + "!");
print("repeated: " + repeat("ab", 4));
print("padded:   " + pad("7", 5) + "|");
print("length:   " + tostring(len(greeting)));
print("empty:    " + tostring(len("")));
print("compare:  " + tostring(greeting == "hello") + " " + tostring(greeting == "goodbye"));
print("same:     " + tostring(sameCharacters("abc", "abc")) + " " + tostring(sameCharacters("abc", "cba")));
print("anagram:  " + tostring(areAnagrams("abc", "cba")) + " " + tostring(areAnagrams("abc", "abd")));
print("prefix:   " + tostring(startsWith(greeting, "hell")) + " " + tostring(startsWith(greeting, "ello")));
print("suffix:   " + tostring(endsWith(greeting, "llo")) + " " + tostring(endsWith(greeting, "ell")));
print("find:     " + tostring(indexOf(greeting, "ll")) + " " + tostring(indexOf(greeting, "zz")));
print("slice:    " + substr(greeting, 1, 3) + " " + substr(greeting, 3, 99) + " " + substr(greeting, 1, 0 - 1));
print("case:     " + upper(greeting) + " " + lower("MiXeD"));
print("trim:     [" + trim("  padded  ") + "]");
print("replace:  " + replace("a-b-c", "-", "+") + " " + replace("a-b-c", "z", "+"));
print("count:    " + tostring(countOf("ab", "ababab")) + " " + tostring(countOf("ab", "aaaa")));
print("index:    " + greeting[0] + greeting[len(greeting) - 1] + " " + greeting[1]);
print("indexed:  " + tostring(len(greeting[0])));
print("escapes:  tab[\t] quote[\"] slash[\\]");
print("types:    " + typeOf(greeting) + " " + typeOf(len(greeting)) + " " + typeOf(greeting[0]));
print("convert:  " + tostring(tonumber("17")) + " " + tostring(tonumber("nope")));
