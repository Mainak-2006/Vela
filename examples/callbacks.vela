// callbacks.vela — passing functions around, now that Vela has function values.
//
// A function can be stored in a `function`-typed variable, passed as an
// argument, and returned from a function. That is enough for the pattern every
// language reaches for sooner or later: a function that takes another function.
//
// The caveat is worth stating once. A variable declared `function` records *that*
// a function is stored, not which signature. So a call through one cannot be
// checked: no arity check, and the result has no known type, which is why the
// helpers below take an `any` and convert it explicitly. A named type like
// `(number) -> number` would check both, at the cost of a function being
// storable under only one exact signature.

fn double(x: number): number { return x * 2; }
fn square(x: number): number { return x * x; }
fn negate(x: number): number { return 0 - x; }

// Call a function value and render the result. `op(x)` has type 'any' because
// the signature was not recorded, so `tostring` is how that 'any' becomes a
// value this function can return.
fn applyToText(op: function, x: number): string {
    return "f(" + tostring(x) + ") = " + tostring(op(x));
}

// A function value stored in a variable and reassigned. This is the thing
// `function` buys: without it, only a direct call by name is possible.
print("stored and reassigned:");
let f: function = double;
print(applyToText(f, 21));
f = square;
print(applyToText(f, 5));
f = negate;
print(applyToText(f, 5));

print("through a parameter:");
print(applyToText(double, 10));
print(applyToText(square, 4));

// Returning a function from a function. Which one is chosen is decided by the
// condition, not by anything captured — Vela cannot build a closure that reads a
// local, because a function value names a signature and nothing more.
fn pick(flag: bool): function {
    if (flag) { return square; }
    return double;
}

print("returned as a value:");
let picked: function = pick(true);
print(applyToText(picked, 6));
picked = pick(false);
print(applyToText(picked, 6));

// Choose one of two functions on a condition, then apply the choice. Branching on
// a bool is how you vary behaviour when there is no dispatch table.
fn applyEither(flag: bool, whenTrue: function, whenFalse: function, x: number): string {
    let chosen: function = whenFalse;
    if (flag) { chosen = whenTrue; }
    return applyToText(chosen, x);
}

// Two functions that call each other. A `let` must be declared before use, but a
// function signature is hoisted before any body is checked, so the forward
// reference in `isEven` resolves. Older versions of this language demanded a
// single function with a mode parameter instead; that workaround is gone.
fn isEven(n: number): bool {
    if (n == 0) { return true; }
    return isOdd(n - 1);
}

fn isOdd(n: number): bool {
    if (n == 0) { return false; }
    return isEven(n - 1);
}

print("chosen by a flag:");
print(applyEither(true, double, square, 4));
print(applyEither(false, double, square, 4));

print("mutual recursion:");
print(tostring(isEven(10)) + " " + tostring(isOdd(10)) + " " + tostring(isEven(7)));
